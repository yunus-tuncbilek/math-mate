# Copy to `.env` and fill in real values. NEVER commit the real .env.

# Flask session signing key (required). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
secret_key=change-me

# Together AI API key powering the chat (required to actually call the LLM).
TOGETHER_API_KEY=your-together-api-key

# Database connection string.
# Defaults to a local SQLite file (data/mathmate.db) if unset — good for dev
# and the Docker image. To use Supabase/Postgres instead, uncomment and set:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# (Postgres also needs psycopg2-binary — see requirements.txt.)
# DATABASE_URL=sqlite:///data/mathmate.db

# --- Optional: only if you wire up Supabase's client SDK later ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-key
